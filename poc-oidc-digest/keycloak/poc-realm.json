{
  "realm": "poc",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "swagger-ui",
      "name": "Swagger UI (public, password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "webOrigins": [
        "http://localhost:8090"
      ],
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.org",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ]
}
