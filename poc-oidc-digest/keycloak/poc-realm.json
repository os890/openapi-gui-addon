{
  "realm": "poc",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "swagger-ui",
      "name": "Swagger UI (public, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "fullScopeAllowed": true
    },
    {
      "clientId": "module-a",
      "name": "Module A (bearer-only resource server)",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.org",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ]
}
