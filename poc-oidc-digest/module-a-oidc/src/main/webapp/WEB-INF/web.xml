<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- OIDC via WildFly elytron-oidc-client; configuration in WEB-INF/oidc.json (bearer-only). -->
    <login-config>
        <auth-method>OIDC</auth-method>
    </login-config>

    <!-- Protect only the REST resource (/module-a/profile). The Swagger UI (/module-a/openapi-ui),
         its webjars, and the OpenAPI document (/module-a/openapi) stay open so the bundled UI loads
         and can fetch the spec without a token. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>module-a-api</web-resource-name>
            <url-pattern>/profile</url-pattern>
            <url-pattern>/profile/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <!-- ** = any authenticated user -->
            <role-name>**</role-name>
        </auth-constraint>
    </security-constraint>

</web-app>
